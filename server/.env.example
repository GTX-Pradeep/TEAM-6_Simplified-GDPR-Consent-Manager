# Copy this file to .env and adjust if needed.  Never commit the real .env file.
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml (local PostgreSQL in Docker)
DATABASE_URL=postgresql://gdpr:gdpr_dev_password@localhost:5432/gdpr_consent?schema=public

# Long random string used to sign login tokens (generate your own for production)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Front-end origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional (defaults shown): minutes of inactivity before a login expires, bcrypt cost
# SESSION_TTL_MINUTES=15
# BCRYPT_ROUNDS=12
